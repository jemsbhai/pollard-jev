include README.md LICENSE CHANGELOG.md AGENTS.md
include docs/POLLARD_API.md docs/openjev.md docs/IMPLEMENTATION.md docs/RELEASING.md
include docs/BENCHMARKING.md docs/benchmarks/2026-09-27-4b.json
include docs/REPRESENTATION_EXPERIMENT.md docs/benchmarks/2026-09-27-rules-comparison.json
include docs/benchmarks/2026-10-05-rules-v2-development.json
recursive-include src/pollard_jev *.py py.typed
recursive-include tests *.py
recursive-include examples *.py
recursive-include scripts *.py
exclude POLLARD_JEV_START.md IMPLEMENTATION_PLAN.md
exclude docs/STATUS.md
prune artifacts
prune .venv
prune .git
prune build
prune dist
global-exclude __pycache__ *.py[cod] .env .env.* .pypirc *.pem *.key
